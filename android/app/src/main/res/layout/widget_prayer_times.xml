<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- Mosque silhouette art on top-right background -->
    <ImageView
        android:layout_width="160dp"
        android:layout_height="75dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/widget_mosque_silhouette"
        android:scaleType="fitXY" />

    <!-- Main Widget Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- ROW 1: Header (Left Brand + Center Clock Arch + Right Weather & Location) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left: Brand + Arabic Subtitle + Quote -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.0"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/widget_emblem"
                    android:scaleType="fitCenter" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="— نور الإسلام —"
                        android:textColor="#e6c670"
                        android:textSize="8.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="0.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="May Allah accept our prayers\nand keep us on the right path 🤍"
                        android:textColor="#9ed8bf"
                        android:textSize="5.8sp"
                        android:layout_marginTop="0.5dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Center: Golden Mihrab Clock Arch -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_arch_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/widget_clock_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#ffffff"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:format12Hour="hh:mm a" />

                <TextView
                    android:id="@+id/widget_hijri_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sat, 29 Rabi-us-Sani 1448 AH"
                    android:textColor="#e6c670"
                    android:textSize="6.8sp"
                    android:textStyle="bold"
                    android:layout_marginTop="0.5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌂"
                    android:textColor="#e6c670"
                    android:textSize="6sp" />
            </LinearLayout>

            <!-- Right: Weather & Location Glass Pills (Ample width to avoid truncation) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:layout_marginStart="4dp">

                <!-- Weather Pill -->
                <LinearLayout
                    android:id="@+id/widget_weather_pill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill_bg"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginEnd="3dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/ic_widget_weather"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_weather_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="28°C"
                            android:textColor="#ffffff"
                            android:textSize="8.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_weather_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Partly Cloudy"
                            android:textColor="#cbd5e1"
                            android:textSize="7sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Location Pill -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/widget_pill_bg"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/ic_widget_location"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widget_location_area"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ghauri Town"
                            android:textColor="#ffffff"
                            android:textSize="8sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/widget_location_city"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Islamabad"
                            android:textColor="#cbd5e1"
                            android:textSize="7sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ROW 2: Next Prayer Pill Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:background="@drawable/widget_next_banner_bg"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/widget_next_icon"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next Prayer"
                android:textColor="#fef08a"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="#4d826a"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_next_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dhuhr"
                android:textColor="#facc15"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  |  "
                android:textColor="#4d826a"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="11:56 AM"
                android:textColor="#ffffff"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ROW 3: Prayer Times 5 Cards (Increased Height minHeight=74dp, zero clipping) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- Fajr -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="74dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp">

                <LinearLayout
                    android:id="@+id/card_fajr_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="74dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_fajr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fajr"
                        android:textColor="#a7f3d0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:id="@+id/widget_fajr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04:45 AM"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فجر"
                        android:textColor="#a7f3d0"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_fajr_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="74dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_active_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_fajr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fajr"
                        android:textColor="#fef08a"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:id="@+id/widget_fajr_time_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04:45 AM"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فجر"
                        android:textColor="#ffd700"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Dhuhr -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="74dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp">

                <LinearLayout
                    android:id="@+id/card_dhuhr_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="74dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_dhuhr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dhuhr"
                        android:textColor="#a7f3d0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:id="@+id/widget_dhuhr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11:56 AM"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ظهر"
                        android:textColor="#a7f3d0"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_dhuhr_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="74dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_active_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_dhuhr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dhuhr"
                        android:textColor="#fef08a"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:id="@+id/widget_dhuhr_time_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11:56 AM"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ظهر"
                        android:textColor="#ffd700"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Asr -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="74dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp">

                <LinearLayout
                    android:id="@+id/card_asr_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="74dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_asr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asr"
                        android:textColor="#a7f3d0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:id="@+id/widget_asr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04:00 PM"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عصر"
                        android:textColor="#a7f3d0"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_asr_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="74dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_active_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_asr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asr"
                        android:textColor="#fef08a"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:id="@+id/widget_asr_time_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04:00 PM"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عصر"
                        android:textColor="#ffd700"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Maghrib -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="74dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp">

                <LinearLayout
                    android:id="@+id/card_maghrib_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="74dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_maghrib"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib"
                        android:textColor="#a7f3d0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:id="@+id/widget_maghrib_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:40 PM"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مغرب"
                        android:textColor="#a7f3d0"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_maghrib_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="74dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_active_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_maghrib"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib"
                        android:textColor="#fef08a"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:id="@+id/widget_maghrib_time_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:40 PM"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مغرب"
                        android:textColor="#ffd700"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Isha -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="74dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/card_isha_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="74dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_isha"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isha"
                        android:textColor="#a7f3d0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:id="@+id/widget_isha_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07:02 PM"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عشاء"
                        android:textColor="#a7f3d0"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_isha_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="74dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_active_bg"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_isha"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isha"
                        android:textColor="#fef08a"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:id="@+id/widget_isha_time_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07:02 PM"
                        android:textColor="#ffffff"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:layout_marginTop="1.5dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عشاء"
                        android:textColor="#ffd700"
                        android:textSize="10sp"
