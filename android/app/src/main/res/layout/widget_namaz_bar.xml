<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="8dp">

        <!-- Top Row: Next Prayer Banner (Left) + Location Pill (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Next Prayer Banner -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_next_banner_bg"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginEnd="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/widget_next_icon"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next Prayer"
                    android:textColor="#fef08a"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  |  "
                    android:textColor="#4d826a"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/widget_next_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dhuhr"
                    android:textColor="#facc15"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  |  "
                    android:textColor="#4d826a"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/widget_next_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:56 AM"
                    android:textColor="#ffffff"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Location Pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/ic_widget_location"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/widget_location_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghauri Town, Islamabad"
                    android:textColor="#cbd5e1"
                    android:textSize="8.5sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Row: 5 Big, Tall Prayer Cards (minHeight=76dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- Fajr -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp">

                <LinearLayout
                    android:id="@+id/card_fajr_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_fajr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fajr"
                        android:textColor="#a7f3d0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/widget_fajr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04:45 AM"
                        android:textColor="#ffffff"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فجر"
                        android:textColor="#a7f3d0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_fajr_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_active_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_fajr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fajr"
                        android:textColor="#fef08a"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/widget_fajr_time_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04:45 AM"
                        android:textColor="#ffffff"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="فجر"
                        android:textColor="#ffd700"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Dhuhr -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp">

                <LinearLayout
                    android:id="@+id/card_dhuhr_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_dhuhr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dhuhr"
                        android:textColor="#a7f3d0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/widget_dhuhr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11:56 AM"
                        android:textColor="#ffffff"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ظهر"
                        android:textColor="#a7f3d0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_dhuhr_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_active_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_dhuhr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dhuhr"
                        android:textColor="#fef08a"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/widget_dhuhr_time_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11:56 AM"
                        android:textColor="#ffffff"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ظهر"
                        android:textColor="#ffd700"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Asr -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp">

                <LinearLayout
                    android:id="@+id/card_asr_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_asr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asr"
                        android:textColor="#a7f3d0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/widget_asr_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04:00 PM"
                        android:textColor="#ffffff"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عصر"
                        android:textColor="#a7f3d0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_asr_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_active_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_asr"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asr"
                        android:textColor="#fef08a"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/widget_asr_time_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04:00 PM"
                        android:textColor="#ffffff"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عصر"
                        android:textColor="#ffd700"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Maghrib -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:layout_weight="1"
                android:layout_marginEnd="3dp">

                <LinearLayout
                    android:id="@+id/card_maghrib_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_maghrib"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib"
                        android:textColor="#a7f3d0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/widget_maghrib_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:40 PM"
                        android:textColor="#ffffff"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مغرب"
                        android:textColor="#a7f3d0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_maghrib_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_active_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_maghrib"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib"
                        android:textColor="#fef08a"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/widget_maghrib_time_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="05:40 PM"
                        android:textColor="#ffffff"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مغرب"
                        android:textColor="#ffd700"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Isha -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="76dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/card_isha_normal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_isha"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isha"
                        android:textColor="#a7f3d0"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/widget_isha_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07:02 PM"
                        android:textColor="#ffffff"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عشاء"
                        android:textColor="#a7f3d0"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card_isha_active"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/widget_item_active_bg"
                    android:paddingTop="7dp"
                    android:paddingBottom="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_widget_isha"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isha"
                        android:textColor="#fef08a"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/widget_isha_time_active"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="07:02 PM"
                        android:textColor="#ffffff"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عشاء"
                        android:textColor="#ffd700"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
